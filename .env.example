# IA: use uma chave server-side. Nunca use o prefixo NEXT_PUBLIC_.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# WhatsApp Cloud API oficial da Meta. Configure estes valores no ambiente Vercel.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Selecione uma versão Graph API ainda suportada na conta Meta (formato vNN.0).
WHATSAPP_GRAPH_API_VERSION=
